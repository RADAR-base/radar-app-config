<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    <property name="autoIncrement" value="true" dbms="mysql,postgresql,oracle,mssql"/>

    <changeSet id="3" author="pim" dbms="postgresql,h2">
        <addColumn tableName="config">
            <column name="create_timestamp" type="timestamp"/>
        </addColumn>
        <addColumn tableName="config">
            <column name="created_by_user" type="varchar(255)"/>
        </addColumn>
        <addColumn tableName="config">
            <column name="version" type="int"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
